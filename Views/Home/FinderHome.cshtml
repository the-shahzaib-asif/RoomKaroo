@model List<RoomIQ.Models.Hostel>
@{
    ViewData["Title"] = "Finder Home";
    var areas = new[] { "All", "Johar Town", "Model Town", "Anarkali", "Gulberg" };
}

<div class="container mt-5">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Finder Home — Search Hostels</h2>
        <p class="text-secondary small mb-0">Filter by area, gender, and monthly budget, then message the owner on WhatsApp.</p>
    </div>

    <!-- Dynamic Filter Bar -->
    <form method="get" asp-controller="Home" asp-action="FinderHome" class="riq-box mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="riq-label">Area</label>
                <select name="area" class="riq-input">
                    @foreach (var a in areas)
                    {
                        <option value="@a" selected="@(ViewBag.SelectedArea == a)">@a</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="riq-label">Gender</label>
                <select name="gender" class="riq-input">
                    <option value="All" selected="@(ViewBag.SelectedGender == "All")">All</option>
                    <option value="Boys" selected="@(ViewBag.SelectedGender == "Boys")">Boys</option>
                    <option value="Girls" selected="@(ViewBag.SelectedGender == "Girls")">Girls</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="riq-label">Max Price (PKR)</label>
                <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" placeholder="e.g. 20000" class="riq-input" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn-dark-riq w-100">Search</button>
            </div>
        </div>
    </form>

    <!-- Dynamic Hostel Cards -->
    <div class="row g-4">
        @foreach (var item in Model)
        {
            var waLink = $"https://wa.me/{item.WhatsApp}?text=Assalam-o-Alaikum, I saw your listing '{item.Name}' on RoomIQ.";
            <div class="col-md-4">
                <div class="riq-card">
                    <img src="@item.ImageUrl" alt="@item.Name" class="riq-card-img" />
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="small text-secondary fw-medium">@item.Area, Lahore</span>
                            <span class="riq-tag">@item.Gender</span>
                        </div>
                        <h5 class="fw-bold mb-2">@item.Name</h5>
                        <p class="small text-secondary mb-2"><strong>Facilities:</strong> @item.Facilities</p>
                        <p class="small text-secondary mb-3"><strong>Owner:</strong> @item.OwnerName</p>

                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold">Rs. @item.Price.ToString("N0")</span>
                                <span class="text-secondary small">/mo</span>
                            </div>
                            <a href="@waLink" target="_blank" class="btn-wa-riq">
                                Contact on WhatsApp
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>