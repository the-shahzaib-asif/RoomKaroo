@{
    ViewData["Title"] = "Sign Up";
}

<div class="container mt-5" style="max-width: 440px;">
    <div class="riq-box p-4">
        <h3 class="fw-bold mb-1">Create an account</h3>
        <p class="text-secondary small mb-4">Join RoomIQ as a Student Finder or Hostel Lister.</p>

        <form method="post" asp-controller="Account" asp-action="Signup">
            <div class="mb-3">
                <label class="riq-label">Full Name</label>
                <input type="text" name="fullName" class="riq-input" placeholder="Shahzaib Asif" required />
            </div>
            <div class="mb-3">
                <label class="riq-label">Email Address</label>
                <input type="email" name="email" class="riq-input" placeholder="you@example.com" required />
            </div>
            <div class="mb-3">
                <label class="riq-label">Password</label>
                <input type="password" name="password" class="riq-input" placeholder="Create a password" required />
            </div>
            <div class="mb-4">
                <label class="riq-label">Account Type</label>
                <select name="role" class="riq-input">
                    <option value="Finder">Student (Finder)</option>
                    <option value="Lister">Hostel Owner (Lister)</option>
                </select>
            </div>
            <button type="submit" class="btn-dark-riq w-100 mb-3">Sign Up</button>
            <div class="text-center small text-secondary">
                Already have an account? <a asp-action="Login">Login</a>
            </div>
        </form>
    </div>
</div>