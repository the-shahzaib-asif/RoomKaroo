@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5" style="max-width: 420px;">
    <div class="riq-box p-4">
        <h3 class="fw-bold mb-1">Welcome back</h3>
        <p class="text-secondary small mb-4">Sign in with your RoomKaroo Identity account.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
        }

        <form method="post" asp-controller="Account" asp-action="Login">
            <div class="mb-3">
                <label class="riq-label">Email Address</label>
                <input type="email" name="email" class="riq-input" required />
            </div>
            <div class="mb-4">
                <label class="riq-label">Password</label>
                <input type="password" name="password" class="riq-input" required />
            </div>
            <button type="submit" class="btn-dark-riq w-100 mb-3">Sign In</button>
            <div class="text-center small text-secondary">
                New here? <a asp-action="Signup">Create an account</a>
            </div>
        </form>
    </div>
</div>